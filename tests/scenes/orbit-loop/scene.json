{
  "id": "orbit",
  "title": "Signal orbit (graphic loop)",
  "profile": "strict-css",
  "synthetic": true,
  "reference": { "clip": "tests/fixtures/synthetic/clips/orbit-loop.mp4" },
  "stage": { "selector": ".v2c-orbit", "width": 640, "height": 360 },
  "timing": { "duration": 4.0, "loop": true, "offset": 0 },
  "controls": [
    { "name": "--v2c-orbit-accent", "kind": "runtime", "type": "color",
      "default": "#ff6a49", "range": null, "variant": "#7cf29a",
      "description": "orbiting dot colour" },
    { "name": "--v2c-orbit-period", "kind": "runtime", "type": "time", "unit": "s",
      "default": "4s", "range": ["2s", "8s"], "variant": "6s",
      "description": "master loop period: dot orbit and tile quarter-turn cycle; ring pulse and bar pulses run at period/2, bar stagger scales with it" },
    { "name": "--v2c-orbit-radius", "kind": "runtime", "type": "length", "unit": "px",
      "default": "112px", "range": ["84px", "150px"], "variant": "140px",
      "description": "orbit radius of the dot around the ring centre (keep >= 84px to clear the ring at full pulse; <= 150px stays inside the stage)" },
    { "name": "--v2c-orbit-ring-color", "kind": "runtime", "type": "color",
      "default": "#4fd1cb", "range": null, "variant": "#f2a7ff",
      "description": "ring stroke colour" },
    { "name": "--v2c-orbit-tile-color", "kind": "runtime", "type": "color",
      "default": "#8c7bf6", "range": null, "variant": "#ff9f43",
      "description": "rotating tile colour" },
    { "name": "--v2c-orbit-bar-max", "kind": "runtime", "type": "length", "unit": "px",
      "default": "96px", "range": ["40px", "200px"], "variant": "130px",
      "description": "peak bar height (rest height is fixed at 24px)" }
  ],
  "tracks": [
    { "part": "dot", "selector": ".v2c-orbit__dot", "color": "#ff6a49", "tolerance": 60, "roi": [0, 0, 640, 360] },
    { "part": "ring", "selector": ".v2c-orbit__ring", "color": "#4fd1cb", "tolerance": 70, "roi": [200, 60, 240, 240] },
    { "part": "tile", "selector": ".v2c-orbit__tile-face", "color": "#8c7bf6", "tolerance": 50, "roi": [60, 120, 120, 120] },
    { "part": "tile-marker", "selector": ".v2c-orbit__tile-face", "color": "#ffffff", "tolerance": 60, "roi": [60, 120, 120, 120] },
    { "part": "bar-1", "selector": ".v2c-orbit__bar:nth-child(1)", "color": "#f6c445", "tolerance": 60, "roi": [486, 150, 28, 150] },
    { "part": "bar-2", "selector": ".v2c-orbit__bar:nth-child(2)", "color": "#f6c445", "tolerance": 60, "roi": [514, 150, 28, 150] },
    { "part": "bar-3", "selector": ".v2c-orbit__bar:nth-child(3)", "color": "#f6c445", "tolerance": 60, "roi": [542, 150, 28, 150] }
  ]
}
